## syntax=docker/dockerfile:1.7
# HAPI FHIR base image — tag for Renovate, digest (manifest list, multi-arch)
# for reproducibility; the digest wins when both are given.
# v8.12.0-2 bundles cqf-fhir-cr 4.13.0 (v8.12.0-1: 4.9.0). The Parameters
# converter bug of CR 4.9 is fixed upstream in 4.12.0; the sidecar keeps
# requesting only scalar defines via expression= anyway.
# Details: ARCHITECTURE.md -> 'clinical-reasoning >= 4.9 Parameters-Converter'.
ARG HAPI_BASE=hapiproject/hapi:v8.12.0-2@sha256:0ff86aac4c7bd13a1ee226444a70263bb46ed1c28ef543c30a44f865b80ca04e
ARG MII_PRO_VERSION=2027.0.0-ballot.1
ARG MII_PRO_SHA256=5085656d8ff49cf10a2e14f9f80c0b6f683c51a1dd190838761604df1e57f0db
ARG SDC_VERSION=4.0.0
ARG SDC_SHA256=d785be8474c7ec7988e32e326430d9ca4aeb2cac4a1f195022e4d6f7dc5c5291
# Older MII PRO versions kept as first-class content (profiles + terminology
# installed per version, Questionnaires/Libraries loaded by the post-boot
# loader via canonical|version). Space-separated; each must be vendored as
# local-packages/de.medizininformatikinitiative.kerndatensatz.pros-<v>.tgz.
# Needed so QuestionnaireResponses pinned to an earlier version keep resolving
# (see ARCHITECTURE.md "Version retention"). Empty string = latest only.
ARG MII_PRO_RETAINED_VERSIONS="2026.7.0"
# "Our" versions — single source of truth lives in versions.env at repo root.
# CI sources versions.env and passes --build-arg; docker-compose reads it via
# `env_file:`. NO defaults here on purpose: builds must be explicit about the
# runtime + content versions they ship.
#
# - FORM_MANAGER_VERSION  — this repo's runtime SemVer (HAPI image + sidecar).
# - PRO_LIBRARY_VERSION   — bundled BIH-CEI/pro-library content version.
ARG FORM_MANAGER_VERSION
ARG PCOR_MII_VERSION
ARG PRO_LIBRARY_VERSION

FROM debian:bookworm-slim AS fetch
ARG MII_PRO_VERSION
ARG MII_PRO_SHA256
ARG MII_PRO_RETAINED_VERSIONS
ARG SDC_VERSION
ARG SDC_SHA256
ARG PCOR_MII_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /pkgs /lucene

# MII PRO — verified upstream tarball, used as-is
RUN curl -sfL --retry 5 --retry-all-errors --retry-delay 5 "https://packages.simplifier.net/de.medizininformatikinitiative.kerndatensatz.pros/${MII_PRO_VERSION}" \
        -o "/pkgs/de.medizininformatikinitiative.kerndatensatz.pros-${MII_PRO_VERSION}.tgz" \
 && echo "${MII_PRO_SHA256}  /pkgs/de.medizininformatikinitiative.kerndatensatz.pros-${MII_PRO_VERSION}.tgz" \
        | sha256sum -c -

# Retained MII PRO versions — vendored tarballs (bytes pinned by git), copied
# next to the current one. application.yaml gets one installer entry each.
COPY local-packages/de.medizininformatikinitiative.kerndatensatz.pros-*.tgz /tmp/retained/
COPY hapi-config/application.yaml hapi-scripts/render-application-yaml.py /tmp/cfg/
RUN set -e; for v in ${MII_PRO_RETAINED_VERSIONS}; do \
      f="/tmp/retained/de.medizininformatikinitiative.kerndatensatz.pros-${v}.tgz"; \
      [ -f "$f" ] || { echo "retained MII PRO ${v}: tarball not vendored in local-packages/" >&2; exit 1; }; \
      [ "$v" != "${MII_PRO_VERSION}" ] || { echo "retained MII PRO ${v} equals MII_PRO_VERSION" >&2; exit 1; }; \
      cp "$f" /pkgs/; echo "retained MII PRO ${v}: vendored tarball bundled"; \
    done; \
    python3 /tmp/cfg/render-application-yaml.py /tmp/cfg/application.yaml /tmp/cfg/application.rendered.yaml "${MII_PRO_RETAINED_VERSIONS}"

# SDC — fetch upstream, verify, then patch resource-level status: "draft" → "active"
# so HAPI's PackageInstallerSvc accepts SD/CS/VS during STORE_AND_INSTALL.
# HL7 ships SDC 3.0.0 with status=draft on all artefacts (SDC has been "trial-use"
# indefinitely); HAPI rejects draft on auto-install. The patch only touches the
# top-level `status` field, never nested resources.
RUN curl -sfL --retry 5 --retry-all-errors --retry-delay 5 "https://packages.simplifier.net/hl7.fhir.uv.sdc/${SDC_VERSION}" \
        -o "/pkgs/sdc-upstream.tgz" \
 && echo "${SDC_SHA256}  /pkgs/sdc-upstream.tgz" | sha256sum -c - \
 && mkdir -p /tmp/sdc && tar xzf /pkgs/sdc-upstream.tgz -C /tmp/sdc

# PCOR-MII — vendored official IG build (gh-pages tgz is rebuilt on every
# deploy, so bytes are pinned by vendoring). Ships ALL terminology as
# status=draft (36 CS, 35 VS, 1 CM), which HAPI's installer skips just like
# SDC's — without the patch the 20 PCOR Questionnaires load (via the post-boot
# loader) but their answerValueSets do not resolve.
COPY local-packages/pcor-mii-${PCOR_MII_VERSION}.tgz /tmp/pcor-upstream.tgz
RUN mkdir -p /tmp/pcor && tar xzf /tmp/pcor-upstream.tgz -C /tmp/pcor

RUN python3 <<'PY'
import json, glob
PATCH_TYPES = {
    'StructureDefinition', 'CodeSystem', 'ValueSet',
    'SearchParameter', 'OperationDefinition', 'CapabilityStatement',
    'StructureMap', 'ImplementationGuide', 'ConceptMap',
}
for label, root in (('SDC', '/tmp/sdc'), ('PCOR-MII', '/tmp/pcor')):
    patched = 0
    for fp in glob.glob(f'{root}/package/*.json'):
        try:
            with open(fp) as f: d = json.load(f)
        except Exception:
            continue
        if d.get('resourceType') in PATCH_TYPES and d.get('status') == 'draft':
            d['status'] = 'active'
            with open(fp, 'w') as f: json.dump(d, f)
            patched += 1
    print(f'{label}: patched {patched} draft→active resources')
PY

RUN cd /tmp/sdc && tar czf "/pkgs/hl7.fhir.uv.sdc-${SDC_VERSION}.tgz" package/ \
 && rm /pkgs/sdc-upstream.tgz \
 && cd /tmp/pcor && tar czf "/pkgs/pcor-mii-${PCOR_MII_VERSION}.tgz" package/

FROM ${HAPI_BASE}
ARG MII_PRO_VERSION
ARG MII_PRO_RETAINED_VERSIONS
ARG SDC_VERSION
ARG PRO_LIBRARY_VERSION
ARG FORM_MANAGER_VERSION
ARG PCOR_MII_VERSION
COPY --from=fetch /pkgs/ /data/hapi/local-packages/
# Empty Lucene index root, owned by the distroless nonroot user so a fresh
# named volume mounted here inherits writable ownership (see application.yaml).
COPY --from=fetch --chown=65532:65532 /lucene /data/hapi/lucene
# PRO Library — built from BIH-CEI/pro-library FSH sources, vendored as
# local-packages/bih-cei.fhir.pro-library-<version>.tgz. 0.x line is provisional.
COPY local-packages/bih-cei.fhir.pro-library-${PRO_LIBRARY_VERSION}.tgz /data/hapi/local-packages/
# PCOR-MII project IG — comes in via /pkgs from the fetch stage (draft→active
# patched there, see above).
# application.yaml rendered in the fetch stage (retained MII PRO entries).
COPY --from=fetch /tmp/cfg/application.rendered.yaml /data/hapi/application.yaml

# NOTE: HAPI's PackageInstallerSvc only installs NamingSystem / CodeSystem /
# ValueSet / StructureDefinition / ConceptMap / SearchParameter / Subscription.
# Questionnaire, Library, Provenance, ImplementationGuide from our packages
# are skipped and must be PUT externally after the server boots — see
# hapi-scripts/load-instance-resources.sh. The HAPI base image is distroless,
# so the loader cannot live inside the image; CI workflow + test compose
# both call it from the host runner against the exposed FHIR endpoint.

# Propagate version build-args to runtime ENV so:
#   - HAPI's application.yaml can interpolate ${PRO_LIBRARY_VERSION} (Spring Boot)
#   - The FastAPI sidecar can report FORM_MANAGER_VERSION via /health + OpenAPI
ENV SPRING_CONFIG_ADDITIONAL_LOCATION=file:/data/hapi/ \
    HAPI_FHIR_CR_ENABLED=true \
    PRO_LIBRARY_VERSION=${PRO_LIBRARY_VERSION} \
    PCOR_MII_VERSION=${PCOR_MII_VERSION} \
    MII_PRO_VERSION=${MII_PRO_VERSION} \
    MII_PRO_RETAINED_VERSIONS="${MII_PRO_RETAINED_VERSIONS}" \
    SDC_VERSION=${SDC_VERSION} \
    FORM_MANAGER_VERSION=${FORM_MANAGER_VERSION}

LABEL org.opencontainers.image.title="FHIR SDC Form Manager (HAPI + SDC + MII PRO + PRO Library)" \
      org.opencontainers.image.vendor="Berlin Institute of Health" \
      org.opencontainers.image.licenses="Apache-2.0" \
      de.mii.kerndatensatz-pro.version="${MII_PRO_VERSION}" \
      de.mii.kerndatensatz-pro.retained-versions="${MII_PRO_RETAINED_VERSIONS}" \
      de.mii.kerndatensatz-pro.source="https://packages.simplifier.net/de.medizininformatikinitiative.kerndatensatz.pros/${MII_PRO_VERSION}" \
      org.hl7.fhir.uv.sdc.version="${SDC_VERSION}" \
      org.hl7.fhir.uv.sdc.source="https://packages.simplifier.net/hl7.fhir.uv.sdc/${SDC_VERSION}" \
      org.hl7.fhir.uv.sdc.modifications="status:draft→active on SD/CS/VS for HAPI auto-install" \
      de.bih-cei.pro-library.version="${PRO_LIBRARY_VERSION}" \
      de.bih-cei.pro-library.source="https://github.com/BIH-CEI/pro-library" \
      de.bih-cei.pro-library.status="provisional (0.x line; see github docs/VISION.md §1a on authority gap)" \
      de.bih-cei.form-manager.version="${FORM_MANAGER_VERSION}" \
      de.bih-cei.form-manager.source="https://github.com/BIH-CEI/fhir-sdc-questionnaire-service"
