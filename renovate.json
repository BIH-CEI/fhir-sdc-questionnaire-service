{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "labels": ["renovate", "mii-pro"],
  "customDatasources": {
    "simplifier-fhir": {
      "defaultRegistryUrlTemplate": "https://packages.simplifier.net/{{packageName}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $['dist-tags'].latest}]}"
      ]
    },
    "pcor-mii-ghpages": {
      "defaultRegistryUrlTemplate": "https://bih-cei.github.io/PCOR-MII/package.manifest.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": version}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "HAPI FHIR base image (tag@digest) in Dockerfile.form-manager",
      "fileMatch": ["^Dockerfile\\.form-manager$"],
      "matchStrings": [
        "ARG HAPI_BASE=(?<depName>hapiproject/hapi):(?<currentValue>v[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "PCOR-MII version pin in versions.env (vendored tgz is refreshed by auto-vendor-pcor-mii)",
      "fileMatch": ["^versions\\.env$"],
      "matchStrings": [
        "PCOR_MII_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "custom.pcor-mii-ghpages",
      "depNameTemplate": "pcor-mii",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "MII PRO version pin in Dockerfile.form-manager",
      "fileMatch": ["^Dockerfile\\.form-manager$"],
      "matchStrings": [
        "ARG MII_PRO_VERSION=(?<currentValue>.+?)\\s"
      ],
      "datasourceTemplate": "custom.simplifier-fhir",
      "depNameTemplate": "de.medizininformatikinitiative.kerndatensatz.pros",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["hapiproject/hapi"],
      "matchManagers": ["custom.regex"],
      "groupName": "HAPI FHIR base image",
      "commitMessageTopic": "HAPI FHIR base image",
      "labels": ["renovate", "hapi"],
      "prBodyNotes": [
        "Check the bundled clinical-reasoning version (`cqf-fhir-cr-*.jar` in /app/main.war). The strict xfails in `api/tests/upstream/` flip when HAPI behaviour changes; update them and ARCHITECTURE.md accordingly."
      ]
    },
    {
      "description": "hapiproject/hapi is managed by the custom regex manager (tag@digest ARG); avoid duplicate PRs from the dockerfile manager",
      "matchPackageNames": ["hapiproject/hapi"],
      "matchManagers": ["dockerfile"],
      "enabled": false
    },
    {
      "matchPackageNames": ["de.medizininformatikinitiative.kerndatensatz.pros"],
      "groupName": "MII PRO IG",
      "commitMessageTopic": "MII PRO",
      "commitMessageAction": "bump",
      "prBodyNotes": [
        "After this PR lands on the renovate branch, the `auto-pin-pro-sha` workflow recomputes and commits the matching `MII_PRO_SHA256`. CI then runs the full build + smoke test."
      ]
    },
    {
      "matchPackageNames": ["pcor-mii"],
      "groupName": "PCOR-MII IG",
      "commitMessageTopic": "PCOR-MII",
      "commitMessageAction": "bump",
      "labels": ["renovate", "pcor-mii"],
      "prBodyNotes": [
        "After this PR lands on the renovate branch, the `auto-vendor-pcor-mii` workflow downloads the matching package.tgz into `local-packages/` and commits it. CI then runs the full build + smoke test."
      ]
    },
    {
      "description": "SDC bumps require manual review — patch table in Dockerfile.form-manager may need extension",
      "matchPackageNames": ["hl7.fhir.uv.sdc"],
      "enabled": false
    }
  ]
}
