# Form Manager deployment settings.
#   cp .env.example .env    then fill in the REQUIRED values.
# .env holds secrets: it stays on the server and is never committed
# (deploy/.gitignore). Restart after changes: docker compose up -d

# --- Images (REQUIRED) ---------------------------------------------------------
# One build for all four images: a sha-<short> or form-manager-<version> tag
# from the GHCR packages, never latest. Update = new tag here, then
#   docker compose pull && docker compose up -d
# Rollback = the previous tag, same commands.
FM_TAG=
# Change only for a mirror of ghcr.io/bih-cei.
FM_REGISTRY=ghcr.io/bih-cei

# --- Database (REQUIRED: password) ----------------------------------------------
# Generate a long random password, e.g.  openssl rand -base64 32
# Set it before the first start: Postgres stores it in its volume on init, so a
# later change here also needs ALTER USER inside the database.
POSTGRES_PASSWORD=
POSTGRES_DB=hapi
POSTGRES_USER=hapi

# --- Access ----------------------------------------------------------------------
# Host port of the mTLS proxy (the container listens on 8443).
PROXY_PORT=443
# Directory with ca.pem, server.pem, server.key, allowlist.map (see pki/README.md).
PKI_DIR=./pki
# production (default): the proxy refuses the committed TEST-ONLY PKI.
# Only CI and local tests set this to test.
MTLS_ENV=production

# --- Optional ----------------------------------------------------------------------
# Origin allowed for browser clients (CORS), e.g. a form renderer at a site.
HAPI_CORS_ALLOWED_ORIGIN=https://localhost
HAPI_DEFAULT_PAGE_SIZE=20
HAPI_MAX_PAGE_SIZE=200
# Sidecar log level: debug, info, warning, error
LOG_LEVEL=info
