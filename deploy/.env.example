# Copy to .env and adjust. Never commit .env.

# One build for all four images: a sha-<short> or form-manager-<version> tag.
FM_TAG=latest
FM_REGISTRY=ghcr.io/bih-cei

POSTGRES_DB=hapi
POSTGRES_USER=hapi
POSTGRES_PASSWORD=change-me

# Host port of the mTLS proxy (container listens on 8443).
PROXY_PORT=443
# Directory with ca.pem, server.pem, server.key, allowlist.map (see README).
PKI_DIR=./pki

# production (default): the proxy refuses the committed TEST-ONLY PKI.
MTLS_ENV=production

LOG_LEVEL=info
